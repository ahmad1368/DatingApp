generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                        String    @id @default(uuid())
  phoneNumber               String?   @unique
  email                     String?   @unique
  googleId                  String?   @unique
  appleUserId               String?   @unique
  name                      String?
  avatarUrl                 String?
  profilePhotoUrl           String?
  isVerified                Boolean   @default(false)
  verifiedAt                DateTime?
  dateOfBirth               DateTime?
  gender                    String?
  relationshipGoal          String?
  interests                 String[]  @default([])
  onboardingCompletedAt     DateTime?
  isPremium                 Boolean   @default(false)
  latitude                  Float?
  longitude                 Float?
  locationUpdatedAt         DateTime?
  searchRadiusKm            Int       @default(50)
  passportLatitude          Float?
  passportLongitude         Float?
  passportEnabled           Boolean   @default(false)
  voiceIntroUrl             String?
  voiceIntroDurationSeconds Int?
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  @@map("users")
}

model OtpCode {
  id          String    @id @default(uuid())
  phoneNumber String
  codeHash    String
  expiresAt   DateTime
  attempts    Int       @default(0)
  consumedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([phoneNumber])
  @@map("otp_codes")
}

model SelfieVerificationChallenge {
  id         String    @id @default(uuid())
  userId     String
  gesture    String
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@map("selfie_verification_challenges")
}
