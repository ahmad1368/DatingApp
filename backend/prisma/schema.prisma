generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                                 String    @id @default(uuid())
  phoneNumber                        String?   @unique
  email                              String?   @unique
  googleId                           String?   @unique
  appleUserId                        String?   @unique
  name                               String?
  avatarUrl                          String?
  profilePhotoUrl                    String?
  isVerified                         Boolean   @default(false)
  verifiedAt                         DateTime?
  dateOfBirth                        DateTime?
  genderIdentities                   String[]  @default([])
  customGenderDescription            String?
  showGenderOnProfile                Boolean   @default(true)
  orientations                       String[]  @default([])
  customOrientationDescription       String?
  showOrientationOnProfile           Boolean   @default(true)
  relationshipGoal                   String?
  interests                          String[]  @default([])
  onboardingCompletedAt              DateTime?
  isPremium                          Boolean   @default(false)
  latitude                           Float?
  longitude                          Float?
  locationUpdatedAt                  DateTime?
  searchRadiusKm                     Int       @default(50)
  passportLatitude                   Float?
  passportLongitude                  Float?
  passportEnabled                    Boolean   @default(false)
  voiceIntroUrl                      String?
  voiceIntroDurationSeconds          Int?
  isCommitteeMember                  Boolean   @default(false)
  relationshipStructure              String?
  showRelationshipStructureOnProfile Boolean   @default(true)
  kinkTags                           String[]  @default([])
  showKinkTagsOnProfile              Boolean   @default(true)
  relationshipDesires                String[]  @default([])
  showRelationshipDesiresOnProfile   Boolean   @default(true)
  partnerUserId                      String?   @unique
  smokingHabit                       String?
  drinkingHabit                      String?
  education                          String?
  religion                           String?
  dietaryPreference                  String?
  wantsChildren                      String?
  filterSmokingHabits                String[]  @default([])
  filterDrinkingHabits               String[]  @default([])
  filterEducationLevels              String[]  @default([])
  filterReligions                    String[]  @default([])
  filterDietaryPreferences           String[]  @default([])
  filterWantsChildren                String[]  @default([])
  filterRelationshipGoals            String[]  @default([])
  incognitoEnabled                   Boolean   @default(false)
  activeMode                         String    @default("DATING")
  snoozedUntil                       DateTime?
  readReceiptsEnabled                Boolean   @default(true)
  instagramUserId                    String?
  instagramAccessToken               String?
  instagramTokenExpiresAt            DateTime?
  instagramMediaUrls                 String[]  @default([])
  instagramSyncedAt                  DateTime?
  spotifyUserId                      String?
  spotifyAccessToken                 String?
  spotifyRefreshToken                String?
  spotifyTokenExpiresAt              DateTime?
  spotifyTopArtists                  String[]  @default([])
  spotifyTopArtistsSyncedAt          DateTime?
  anthemTrackId                      String?
  anthemTrackName                    String?
  anthemArtistName                   String?
  anthemAlbumArtUrl                  String?
  createdAt                          DateTime  @default(now())
  updatedAt                          DateTime  @updatedAt

  @@map("users")
}

model OtpCode {
  id          String    @id @default(uuid())
  phoneNumber String
  codeHash    String
  expiresAt   DateTime
  attempts    Int       @default(0)
  consumedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([phoneNumber])
  @@map("otp_codes")
}

model SelfieVerificationChallenge {
  id         String    @id @default(uuid())
  userId     String
  gesture    String
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@map("selfie_verification_challenges")
}

model Swipe {
  id           String   @id @default(uuid())
  swiperId     String
  targetUserId String
  action       String
  createdAt    DateTime @default(now())

  @@unique([swiperId, targetUserId])
  @@index([swiperId])
  @@index([targetUserId])
  @@map("swipes")
}

model Match {
  id                    String    @id @default(uuid())
  userAId               String
  userBId               String
  createdAt             DateTime  @default(now())
  firstMessageExpiresAt DateTime
  firstMessageSentAt    DateTime?

  messages Message[]

  @@unique([userAId, userBId])
  @@index([userAId])
  @@index([userBId])
  @@map("matches")
}

model Message {
  id          String    @id @default(uuid())
  matchId     String
  senderId    String
  contentType String    @default("TEXT")
  content     String?
  mediaUrl    String?
  isBlurred   Boolean   @default(false)
  readAt      DateTime?
  createdAt   DateTime  @default(now())

  match Match @relation(fields: [matchId], references: [id])

  @@index([matchId])
  @@map("messages")
}

model MessageReport {
  id                   String   @id @default(uuid())
  messageId            String
  reporterId           String
  reason               String
  moderationFlagged    Boolean  @default(false)
  moderationCategories String[] @default([])
  createdAt            DateTime @default(now())

  @@index([messageId])
  @@map("message_reports")
}

model IcebreakerResponse {
  id          String   @id @default(uuid())
  messageId   String
  userId      String
  optionIndex Int
  createdAt   DateTime @default(now())

  @@unique([messageId, userId])
  @@map("icebreaker_responses")
}

model BlockedContact {
  id            String   @id @default(uuid())
  userId        String
  contactValue  String
  blockedUserId String?
  createdAt     DateTime @default(now())

  @@unique([userId, contactValue])
  @@index([userId])
  @@index([blockedUserId])
  @@map("blocked_contacts")
}

model UserReport {
  id             String   @id @default(uuid())
  reporterId     String
  reportedUserId String
  reason         String
  details        String?
  createdAt      DateTime @default(now())

  @@index([reportedUserId])
  @@index([reporterId])
  @@map("user_reports")
}

model DateCheckIn {
  id                    String    @id @default(uuid())
  userId                String
  matchId               String?
  location              String?
  scheduledAt           DateTime
  emergencyContactName  String?
  emergencyContactPhone String?
  notes                 String?
  confirmedAt           DateTime?
  createdAt             DateTime  @default(now())

  @@index([userId])
  @@map("date_check_ins")
}

model PathCrossing {
  id         String   @id @default(uuid())
  userAId    String
  userBId    String
  latitude   Float
  longitude  Float
  distanceKm Float
  crossedAt  DateTime @default(now())

  @@index([userAId, crossedAt])
  @@index([userBId, crossedAt])
  @@map("path_crossings")
}

model Question {
  id        String   @id @default(uuid())
  text      String
  options   String[]
  createdAt DateTime @default(now())

  answers QuestionAnswer[]

  @@map("questions")
}

model QuestionAnswer {
  id                String   @id @default(uuid())
  userId            String
  questionId        String
  answer            String
  acceptableAnswers String[]
  importance        String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  question Question @relation(fields: [questionId], references: [id])

  @@unique([userId, questionId])
  @@index([userId])
  @@index([questionId])
  @@map("question_answers")
}

model DailyPick {
  id                 String   @id @default(uuid())
  userId             String
  candidateId        String
  windowStart        DateTime
  compatibilityScore Int?
  createdAt          DateTime @default(now())

  @@unique([userId, candidateId, windowStart])
  @@index([userId, windowStart])
  @@map("daily_picks")
}

model ProfileItemLike {
  id         String   @id @default(uuid())
  fromUserId String
  toUserId   String
  itemType   String
  comment    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([fromUserId, toUserId, itemType])
  @@index([toUserId])
  @@index([fromUserId])
  @@map("profile_item_likes")
}

model Application {
  id              String    @id @default(uuid())
  userId          String    @unique
  status          String    @default("PENDING")
  referralCount   Int       @default(0)
  decidedByUserId String?
  decisionReason  String?
  createdAt       DateTime  @default(now())
  decidedAt       DateTime?

  referrals Referral[]

  @@index([status])
  @@map("applications")
}

model Referral {
  id             String   @id @default(uuid())
  applicationId  String
  referrerUserId String
  createdAt      DateTime @default(now())

  application Application @relation(fields: [applicationId], references: [id])

  @@unique([applicationId, referrerUserId])
  @@index([applicationId])
  @@map("referrals")
}

model CouplePairing {
  id          String    @id @default(uuid())
  requesterId String
  partnerId   String
  status      String    @default("PENDING")
  createdAt   DateTime  @default(now())
  respondedAt DateTime?

  @@unique([requesterId, partnerId])
  @@index([requesterId])
  @@index([partnerId])
  @@map("couple_pairings")
}

model PersonalityProfile {
  id              String   @id @default(uuid())
  userId          String   @unique
  dimensionScores Json
  completedAt     DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("personality_profiles")
}

model CallSession {
  id        String    @id @default(uuid())
  matchId   String
  callerId  String
  calleeId  String
  type      String
  status    String    @default("RINGING")
  offerSdp  String
  answerSdp String?
  createdAt DateTime  @default(now())
  endedAt   DateTime?

  iceCandidates CallIceCandidate[]

  @@index([matchId])
  @@index([calleeId, status])
  @@map("call_sessions")
}

model CallIceCandidate {
  id            String   @id @default(uuid())
  callSessionId String
  senderId      String
  candidate     String
  createdAt     DateTime @default(now())

  callSession CallSession @relation(fields: [callSessionId], references: [id])

  @@index([callSessionId])
  @@map("call_ice_candidates")
}

model Boost {
  id        String   @id @default(uuid())
  userId    String
  expiresAt DateTime
  viewCount Int      @default(0)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@map("boosts")
}
