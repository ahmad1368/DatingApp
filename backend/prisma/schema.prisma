generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                           String    @id @default(uuid())
  phoneNumber                  String?   @unique
  email                        String?   @unique
  googleId                     String?   @unique
  appleUserId                  String?   @unique
  name                         String?
  avatarUrl                    String?
  profilePhotoUrl              String?
  isVerified                   Boolean   @default(false)
  verifiedAt                   DateTime?
  dateOfBirth                  DateTime?
  genderIdentities             String[]  @default([])
  customGenderDescription      String?
  showGenderOnProfile          Boolean   @default(true)
  orientations                 String[]  @default([])
  customOrientationDescription String?
  showOrientationOnProfile     Boolean   @default(true)
  relationshipGoal             String?
  interests                    String[]  @default([])
  onboardingCompletedAt        DateTime?
  isPremium                    Boolean   @default(false)
  latitude                     Float?
  longitude                    Float?
  locationUpdatedAt            DateTime?
  searchRadiusKm               Int       @default(50)
  passportLatitude             Float?
  passportLongitude            Float?
  passportEnabled              Boolean   @default(false)
  voiceIntroUrl                String?
  voiceIntroDurationSeconds    Int?
  createdAt                    DateTime  @default(now())
  updatedAt                    DateTime  @updatedAt

  @@map("users")
}

model OtpCode {
  id          String    @id @default(uuid())
  phoneNumber String
  codeHash    String
  expiresAt   DateTime
  attempts    Int       @default(0)
  consumedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([phoneNumber])
  @@map("otp_codes")
}

model SelfieVerificationChallenge {
  id         String    @id @default(uuid())
  userId     String
  gesture    String
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@map("selfie_verification_challenges")
}

model Swipe {
  id           String   @id @default(uuid())
  swiperId     String
  targetUserId String
  action       String
  createdAt    DateTime @default(now())

  @@unique([swiperId, targetUserId])
  @@index([swiperId])
  @@index([targetUserId])
  @@map("swipes")
}

model Match {
  id                    String    @id @default(uuid())
  userAId               String
  userBId               String
  createdAt             DateTime  @default(now())
  firstMessageExpiresAt DateTime
  firstMessageSentAt    DateTime?

  messages Message[]

  @@unique([userAId, userBId])
  @@index([userAId])
  @@index([userBId])
  @@map("matches")
}

model Message {
  id        String   @id @default(uuid())
  matchId   String
  senderId  String
  content   String
  createdAt DateTime @default(now())

  match Match @relation(fields: [matchId], references: [id])

  @@index([matchId])
  @@map("messages")
}

model Question {
  id        String   @id @default(uuid())
  text      String
  options   String[]
  createdAt DateTime @default(now())

  answers QuestionAnswer[]

  @@map("questions")
}

model QuestionAnswer {
  id                String   @id @default(uuid())
  userId            String
  questionId        String
  answer            String
  acceptableAnswers String[]
  importance        String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  question Question @relation(fields: [questionId], references: [id])

  @@unique([userId, questionId])
  @@index([userId])
  @@index([questionId])
  @@map("question_answers")
}

model DailyPick {
  id                 String   @id @default(uuid())
  userId             String
  candidateId        String
  windowStart        DateTime
  compatibilityScore Int?
  createdAt          DateTime @default(now())

  @@unique([userId, candidateId, windowStart])
  @@index([userId, windowStart])
  @@map("daily_picks")
}

model ProfileItemLike {
  id         String   @id @default(uuid())
  fromUserId String
  toUserId   String
  itemType   String
  comment    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([fromUserId, toUserId, itemType])
  @@index([toUserId])
  @@index([fromUserId])
  @@map("profile_item_likes")
}
