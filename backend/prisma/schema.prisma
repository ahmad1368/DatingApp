generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                                    String    @id @default(uuid())
  phoneNumber                           String?   @unique
  email                                 String?   @unique
  googleId                              String?   @unique
  appleUserId                           String?   @unique
  name                                  String?
  avatarUrl                             String?
  profilePhotoUrl                       String?
  isVerified                            Boolean   @default(false)
  verifiedAt                            DateTime?
  // Snapshot of profilePhotoUrl at the moment verification last succeeded -
  // see VerificationService.getVerificationStatus, which compares this
  // against the current profilePhotoUrl to detect a "major profile photo
  // change" that should trigger re-verification.
  verifiedPhotoUrl                      String?
  dateOfBirth                           DateTime?
  genderIdentities                      String[]  @default([])
  customGenderDescription               String?
  showGenderOnProfile                   Boolean   @default(true)
  orientations                          String[]  @default([])
  customOrientationDescription          String?
  showOrientationOnProfile              Boolean   @default(true)
  relationshipGoal                      String?
  interests                             String[]  @default([])
  onboardingCompletedAt                 DateTime?
  isPremium                             Boolean   @default(false)
  subscriptionTier                      String    @default("FREE")
  subscriptionExpiresAt                 DateTime?
  subscriptionCanceledAt                DateTime?
  giftTokenBalance                      Int       @default(100)
  latitude                              Float?
  longitude                             Float?
  locationUpdatedAt                     DateTime?
  searchRadiusKm                        Int       @default(50)
  autoExpandRadiusEnabled               Boolean   @default(true)
  distanceUnit                          String    @default("KM")
  passportLatitude                      Float?
  passportLongitude                     Float?
  passportEnabled                       Boolean   @default(false)
  voiceIntroUrl                         String?
  voiceIntroDurationSeconds             Int?
  videoSnippetUrl                       String?
  isCommitteeMember                     Boolean   @default(false)
  referralCode                          String?   @unique
  relationshipStructure                 String?
  showRelationshipStructureOnProfile    Boolean   @default(true)
  kinkTags                              String[]  @default([])
  showKinkTagsOnProfile                 Boolean   @default(true)
  relationshipDesires                   String[]  @default([])
  showRelationshipDesiresOnProfile      Boolean   @default(true)
  customRelationshipIntent              String?
  showCustomRelationshipIntentOnProfile Boolean   @default(true)
  communicationBoundaries               String?
  showCommunicationBoundariesOnProfile  Boolean   @default(true)
  // Structured, upfront-honesty tags (e.g. "Sober/Substance-Free", "No
  // Kids") - distinct from communicationBoundaries' freeform text and from
  // kinkTags' sexual-preference scope. See BOUNDARY_TAGS in
  // relationship-profile.constants.ts.
  boundaryTags                          String[]  @default([])
  showBoundaryTagsOnProfile             Boolean   @default(true)
  smokingHabit                          String?
  drinkingHabit                         String?
  education                             String?
  // Dynamic work/education verification: claimed immediately when
  // requested (shown on profile right away, like any other field), but the
  // isXVerified flag only flips true once WorkVerificationService.
  // confirmVerification succeeds - see CredentialVerificationCode.
  jobTitle                              String?
  company                               String?
  school                                String?
  isWorkVerified                        Boolean   @default(false)
  isEducationVerified                   Boolean   @default(false)
  religion                              String?
  dietaryPreference                     String?
  wantsChildren                         String?
  heightCm                              Int?
  workoutHabit                          String?
  petOwnership                          String?
  petAllergyStatus                      String?
  showLifestyleBadgesOnProfile          Boolean   @default(true)
  showZodiacOnProfile                   Boolean   @default(true)
  // Profile header avatar: either a curated 3D style (see AVATAR_STYLES in
  // avatar.constants.ts) or a linked third-party image (e.g. Bitmoji) -
  // mutually exclusive, only one is ever set at a time. See AvatarService.
  avatarStyleId                         String?
  thirdPartyAvatarUrl                   String?
  showAvatarOnProfile                   Boolean   @default(true)
  loveLanguages                         String[]  @default([])
  showLoveLanguagesOnProfile            Boolean   @default(true)
  attachmentStyle                       String?
  showAttachmentStyleOnProfile          Boolean   @default(true)
  politicalOrientation                  String?
  civicActivityLevel                    String?
  filterPoliticalOrientations           String[]  @default([])
  filterSmokingHabits                   String[]  @default([])
  filterDrinkingHabits                  String[]  @default([])
  filterWorkoutHabits                   String[]  @default([])
  filterMinHeightCm                     Int?
  filterMaxHeightCm                     Int?
  filterEducationLevels                 String[]  @default([])
  filterReligions                       String[]  @default([])
  filterDietaryPreferences              String[]  @default([])
  filterWantsChildren                   String[]  @default([])
  filterRelationshipGoals               String[]  @default([])
  filterKinkTags                        String[]  @default([])
  filterRelationshipDesires             String[]  @default([])
  filterBoundaryTags                    String[]  @default([])
  filterPetOwnership                    String[]  @default([])
  filterPetAllergyStatus                String[]  @default([])
  filterSharedInterestsOnly             Boolean   @default(false)
  filterVerifiedOnly                    Boolean   @default(false)
  communityGroupIds                     String[]  @default([])
  filterCommunityGroups                 String[]  @default([])
  incognitoEnabled                      Boolean   @default(false)
  // Opt-in privacy toggle: excludes this user from the discovery deck of
  // anyone who shares a synced contact with them (a "mutual friend" or
  // phonebook connection) - see getMutualConnectionHiddenIds in
  // social-graph.utils.ts. Narrower than incognitoEnabled, which hides from
  // everyone; someone who already liked this user is unaffected either way.
  hideFromMutualConnectionsEnabled      Boolean   @default(false)
  activeMode                            String    @default("DATING")
  // "Couple & Group Profile Browsing Switch": which linked partner (if any)
  // the deck is currently being browsed jointly with - see
  // CouplePairingService.setActiveBrowsingPartner and DiscoveryService.
  // getDeck's joint-exclusion logic. Null means solo browsing.
  activeBrowsingPartnerId               String?
  snoozedUntil                          DateTime?
  snoozeStatusMessage                   String?
  readReceiptsEnabled                   Boolean   @default(true)
  autoBlurIncomingMedia                 Boolean   @default(true)
  bonusSuperLikes                       Int       @default(0)
  // A la carte "Priority Like" credits (see the priority-like-pack-*
  // POWER_UPS entries) - spent one at a time via
  // DiscoveryService.recordSwipe/PowerUpsService.purchasePriorityLike to
  // give a single non-premium regular like the same top-of-queue placement
  // a premium subscriber's regular likes get automatically.
  bonusPriorityLikes                    Int       @default(0)
  // A la carte "Extra Profile Views" power-up: widens the very next
  // getDeck() fetch by this many extra candidates, then resets to 0 - see
  // DiscoveryService.getDeck and PowerUpsService.purchaseExtraProfileViews.
  bonusDeckSlots                        Int       @default(0)
  // Stockpiled boost credits from a discounted bulk pack (see the
  // boost-pack-* POWER_UPS entries) - spent one at a time via
  // PowerUpsService.activateBoost whenever the user wants, instead of
  // activating immediately like a single "boost" purchase does.
  bonusBoosts                           Int       @default(0)
  // A la carte "See Who Liked You" unlock credits (see the
  // see-who-liked-you-unlock* POWER_UPS entries) - spent one at a time via
  // DiscoveryService.getLikedByGrid to let a non-premium user view their
  // likes grid without a subscription.
  bonusSeeWhoLikedYouUnlocks             Int       @default(0)
  // Algorithm-driven match quality feedback: scales the proximity component
  // of rankRemainingCandidates's score, adjusted by DiscoveryService.
  // submitDeckFeedback - see applyDeckFeedback in discovery.constants.ts.
  discoveryProximityWeight              Float     @default(1)
  instagramUserId                       String?
  instagramAccessToken                  String?
  instagramTokenExpiresAt               DateTime?
  instagramMediaUrls                    String[]  @default([])
  instagramSyncedAt                     DateTime?
  spotifyUserId                         String?
  spotifyAccessToken                    String?
  spotifyRefreshToken                   String?
  spotifyTokenExpiresAt                 DateTime?
  spotifyTopArtists                     String[]  @default([])
  spotifyTopArtistsSyncedAt             DateTime?
  anthemTrackId                         String?
  anthemTrackName                       String?
  anthemArtistName                      String?
  anthemAlbumArtUrl                     String?
  screenCaptureViolationCount           Int       @default(0)
  screenCaptureFrozenUntil              DateTime?
  // Feed the "Match Response Rate Indicator Badge" (see
  // DiscoveryService.buildResponseRateBadge) - tallied in
  // MessagingService.trackResponseRate on every message sent/received.
  messagesReceivedCount                 Int       @default(0)
  messagesRepliedCount                  Int       @default(0)
  blurPhotosUntilMatch                  Boolean   @default(false)
  // Per-category multiplier (0-2, default 1) applied to how much each
  // PERSONALITY_CATEGORIES group contributes to this user's own view of
  // their compatibility percentage with someone else - see
  // PersonalityTestService.setCategoryWeights. Null/missing keys fall back
  // to the default weight, so this stays optional.
  compatibilityCategoryWeights           Json?
  // A la carte purchase (see PowerUpsService/POWER_UPS 'unmatch-protection'):
  // once true, MessagingService.dissolveMatch archives a dissolving match's
  // messages into ArchivedMessage instead of deleting them, for either
  // participant who has this enabled.
  unmatchProtectionEnabled               Boolean   @default(false)
  profileCompletionRewardGrantedAt      DateTime?
  lastActiveAt                          DateTime?
  createdAt                             DateTime  @default(now())
  updatedAt                             DateTime  @updatedAt

  @@map("users")
}

model OtpCode {
  id          String    @id @default(uuid())
  phoneNumber String
  codeHash    String
  expiresAt   DateTime
  attempts    Int       @default(0)
  consumedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([phoneNumber])
  @@map("otp_codes")
}

model CredentialVerificationCode {
  id         String    @id @default(uuid())
  userId     String
  email      String
  type       String
  codeHash   String
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@map("credential_verification_codes")
}

model SelfieVerificationChallenge {
  id         String    @id @default(uuid())
  userId     String
  gesture    String
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@map("selfie_verification_challenges")
}

model Swipe {
  id                    String   @id @default(uuid())
  swiperId              String
  targetUserId          String
  action                String
  complimentText        String?
  complimentTarget      String?
  icebreakerPromptId    String?
  icebreakerOptionIndex Int?
  passReason            String?
  // A la carte "Priority Like": a regular like paid for with a
  // User.bonusPriorityLikes credit (see PowerUpsService.purchasePriorityLike)
  // gets the same top-of-queue placement a premium subscriber's regular
  // likes already get automatically - see DiscoveryService.getDeck.
  isPriorityLike        Boolean  @default(false)
  createdAt             DateTime @default(now())

  @@unique([swiperId, targetUserId])
  @@index([swiperId])
  @@index([targetUserId])
  @@map("swipes")
}

model Match {
  id                        String    @id @default(uuid())
  userAId                   String
  userBId                   String
  createdAt                 DateTime  @default(now())
  firstMessageExpiresAt     DateTime
  firstMessageSentAt        DateTime?
  firstMessageExtendedAt    DateTime?
  verificationRequestedAt   DateTime?
  verificationRequestedById String?
  // Set once the "first move" reminder push (see
  // MessagingService.sendFirstMoveRemindersIfNeeded) has fired for this
  // match, so it's only sent once as the 24-hour deadline approaches.
  firstMoveReminderSentAt   DateTime?

  messages Message[]

  @@unique([userAId, userBId])
  @@index([userAId])
  @@index([userBId])
  @@map("matches")
}

model MatchNote {
  id        String   @id @default(uuid())
  userId    String
  matchId   String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, matchId])
  @@map("match_notes")
}

model Message {
  id                   String    @id @default(uuid())
  matchId              String
  senderId             String
  contentType          String    @default("TEXT")
  content              String?
  mediaUrl             String?
  isBlurred            Boolean   @default(false)
  moderationFlagged    Boolean   @default(false)
  moderationCategories String[]  @default([])
  durationSeconds      Int?
  voiceEffectId        String?
  backgroundSoundId    String?
  // Auto-generated caption for a VOICE_NOTE message - see
  // MessagingService.transcribeSafely. Null if transcription failed or the
  // message isn't a voice note.
  transcript           String?
  pollOptions          String[]  @default([])
  // A RESERVATION message: a deep-link to a third-party reservation/ticket
  // platform's search results - see buildReservationUrl in
  // messaging.constants.ts. The search query itself lives in `content`,
  // mirroring how a POLL's question is stored there too.
  reservationProvider  String?
  reservationUrl       String?
  // A GAME_CARD message: TRIVIA/TWO_TRUTHS_AND_A_LIE options reuse
  // `pollOptions` (trivia's 4 choices, or the 3 statements), and `content`
  // holds the curated promptId for TRIVIA/TWENTY_ONE_QUESTIONS - see
  // messaging.constants.ts. gameCorrectIndex is the correct trivia answer or
  // the index of the lie, masked from the guesser until they answer, see
  // MessagingService.toGameCardView.
  gameType             String?
  gameCorrectIndex     Int?
  // Set when a report against this message was confirmed by the AI content
  // moderator - see MessageModerationService.reportMessage. Once set,
  // MessagingService.toMessageView withholds content/mediaUrl from
  // everyone, closing the moderation feedback loop for the reporter.
  moderationRemovedAt  DateTime?
  readAt               DateTime?
  // Auto-expiring media: null expiryMode means a normal, permanent message.
  // See isEphemeralExpired in messaging.constants.ts for how these three
  // combine to decide whether mediaUrl is currently visible.
  expiryMode           String?
  viewTimerSeconds     Int?
  viewedAt             DateTime?
  createdAt            DateTime  @default(now())

  match Match @relation(fields: [matchId], references: [id])

  @@index([matchId])
  @@map("messages")
}

model MessageReport {
  id                   String   @id @default(uuid())
  messageId            String
  reporterId           String
  reason               String
  moderationFlagged    Boolean  @default(false)
  moderationCategories String[] @default([])
  createdAt            DateTime @default(now())

  @@index([messageId])
  @@map("message_reports")
}

// The "report & unmatch" combo action: snapshots the conversation before
// MessagingService.unmatch deletes the underlying Message rows, so a full
// chat log survives for human/AI moderation review after the match is gone.
model MatchReport {
  id                   String   @id @default(uuid())
  matchId              String
  reporterId           String
  reportedUserId       String
  reason               String
  details              String?
  chatLog              Json
  moderationFlagged    Boolean  @default(false)
  moderationCategories String[] @default([])
  createdAt            DateTime @default(now())

  @@index([reportedUserId])
  @@index([reporterId])
  @@map("match_reports")
}

model IcebreakerResponse {
  id          String   @id @default(uuid())
  messageId   String
  userId      String
  optionIndex Int
  createdAt   DateTime @default(now())

  @@unique([messageId, userId])
  @@map("icebreaker_responses")
}

// A vote on an in-chat POLL message (Message.pollOptions holds the choices).
// One vote per user per poll, same shape as IcebreakerResponse but for an
// arbitrary number of options instead of a fixed two.
model PollVote {
  id          String   @id @default(uuid())
  messageId   String
  userId      String
  optionIndex Int
  createdAt   DateTime @default(now())

  @@unique([messageId, userId])
  @@map("poll_votes")
}

// An answer to an in-chat GAME_CARD message (TRIVIA guess or
// TWO_TRUTHS_AND_A_LIE guess) - same one-response-per-user shape as
// IcebreakerResponse/PollVote.
model GameCardResponse {
  id          String   @id @default(uuid())
  messageId   String
  userId      String
  answerIndex Int
  createdAt   DateTime @default(now())

  @@unique([messageId, userId])
  @@map("game_card_responses")
}

// Records that a message's sender has paid (a one-time token spend, or a
// free grant while on a paid subscription tier) to reveal that a specific
// message was actually read - see
// MessagingService.READ_RECEIPT_UNLOCK_TOKEN_COST. Only ever created for
// the sender of the message; the recipient's own read-receipts-enabled
// toggle (User.readReceiptsEnabled) still gates whether Message.readAt gets
// stamped at all in the first place.
model ReadReceiptUnlock {
  id        String   @id @default(uuid())
  messageId String
  userId    String
  createdAt DateTime @default(now())

  @@unique([messageId, userId])
  @@map("read_receipt_unlocks")
}

// A written answer to a structured profile prompt (e.g. "My idea of a
// perfect first date is..."), independent of any voice/video answer to the
// same prompt - see ProfilePromptsService.recordTextAnswer.
model ProfilePromptTextAnswer {
  id        String   @id @default(uuid())
  userId    String
  promptId  String
  answer    String
  createdAt DateTime @default(now())

  @@unique([userId, promptId])
  @@index([userId])
  @@map("profile_prompt_text_answers")
}

model ProfilePromptVoiceAnswer {
  id              String   @id @default(uuid())
  userId          String
  promptId        String
  audioUrl        String
  durationSeconds Int
  // Auto-generated caption/transcript for accessibility and silent browsing
  // (see ProfilePromptsService.transcribeSafely) - null if transcription
  // failed or hasn't run, never blocks saving the answer itself.
  transcript      String?
  createdAt       DateTime @default(now())

  @@unique([userId, promptId])
  @@index([userId])
  @@map("profile_prompt_voice_answers")
}

model ProfilePromptVideoAnswer {
  id              String   @id @default(uuid())
  userId          String
  promptId        String
  videoUrl        String
  durationSeconds Int
  createdAt       DateTime @default(now())

  @@unique([userId, promptId])
  @@index([userId])
  @@map("profile_prompt_video_answers")
}

// A reaction to someone else's ProfilePromptVoiceAnswer: a text comment, a
// recorded audio reply, or both - see ProfilePromptsService.reactToVoicePrompt.
model VoicePromptReaction {
  id              String   @id @default(uuid())
  fromUserId      String
  toUserId        String
  promptId        String
  comment         String?
  audioReplyUrl   String?
  durationSeconds Int?
  createdAt       DateTime @default(now())

  @@index([toUserId, promptId])
  @@map("voice_prompt_reactions")
}

model BlockedContact {
  id            String   @id @default(uuid())
  userId        String
  contactValue  String
  blockedUserId String?
  createdAt     DateTime @default(now())

  @@unique([userId, contactValue])
  @@index([userId])
  @@index([blockedUserId])
  @@map("blocked_contacts")
}

model SocialContact {
  id           String   @id @default(uuid())
  userId       String
  contactValue String
  createdAt    DateTime @default(now())

  @@unique([userId, contactValue])
  @@index([userId])
  @@index([contactValue])
  @@map("social_contacts")
}

model PostMatchSurvey {
  id           String   @id @default(uuid())
  matchId      String
  userId       String
  metInPerson  Boolean
  matchQuality String?
  createdAt    DateTime @default(now())

  @@unique([matchId, userId])
  @@index([matchId])
  @@map("post_match_surveys")
}

model UserReport {
  id             String   @id @default(uuid())
  reporterId     String
  reportedUserId String
  reason         String
  details        String?
  createdAt      DateTime @default(now())

  @@index([reportedUserId])
  @@index([reporterId])
  @@map("user_reports")
}

model GiftTransaction {
  id          String   @id @default(uuid())
  senderId    String
  recipientId String
  giftId      String
  tokenCost   Int
  message     String?
  createdAt   DateTime @default(now())

  @@index([senderId])
  @@index([recipientId])
  @@map("gift_transactions")
}

model SubscriptionGift {
  id          String   @id @default(uuid())
  senderId    String
  recipientId String
  tier        String
  createdAt   DateTime @default(now())

  @@index([senderId])
  @@index([recipientId])
  @@map("subscription_gifts")
}

model CoinPurchase {
  id             String   @id @default(uuid())
  userId         String
  packageId      String
  coinAmount     Int
  priceUsdCents  Int
  createdAt      DateTime @default(now())

  @@index([userId])
  @@map("coin_purchases")
}

model BlindDateQueueEntry {
  id       String   @id @default(uuid())
  userId   String   @unique
  joinedAt DateTime @default(now())

  @@map("blind_date_queue_entries")
}

model BlindDateSession {
  id                   String    @id @default(uuid())
  userAId              String
  userBId              String
  startedAt            DateTime  @default(now())
  expiresAt            DateTime
  userARevealRequested Boolean   @default(false)
  userBRevealRequested Boolean   @default(false)
  revealedAt           DateTime?

  @@index([userAId])
  @@index([userBId])
  @@map("blind_date_sessions")
}

model BlindDateMessage {
  id        String   @id @default(uuid())
  sessionId String
  senderId  String
  content   String
  createdAt DateTime @default(now())

  @@index([sessionId])
  @@map("blind_date_messages")
}

model SpeedDatingQueueEntry {
  id       String   @id @default(uuid())
  userId   String   @unique
  joinedAt DateTime @default(now())

  @@map("speed_dating_queue_entries")
}

model SpeedDatingRound {
  id            String    @id @default(uuid())
  userAId       String
  userBId       String
  startedAt     DateTime  @default(now())
  endsAt        DateTime
  offerSdp      String?
  answerSdp     String?
  userADecision Boolean?
  userBDecision Boolean?
  matchId       String?

  iceCandidates SpeedDatingIceCandidate[]

  @@index([userAId])
  @@index([userBId])
  @@map("speed_dating_rounds")
}

model SpeedDatingIceCandidate {
  id        String   @id @default(uuid())
  roundId   String
  senderId  String
  candidate String
  createdAt DateTime @default(now())

  round SpeedDatingRound @relation(fields: [roundId], references: [id])

  @@index([roundId])
  @@map("speed_dating_ice_candidates")
}

model DateCheckIn {
  id                    String    @id @default(uuid())
  userId                String
  matchId               String?
  location              String?
  scheduledAt           DateTime
  emergencyContactName  String?
  emergencyContactPhone String?
  notes                 String?
  confirmedAt           DateTime?
  alertSentAt           DateTime?
  createdAt             DateTime  @default(now())

  @@index([userId])
  @@map("date_check_ins")
}

// A reusable, named contact a user can pick from when triggering SOS - see
// SosAlert - distinct from DateCheckIn's one-off contact fields, which stay
// tied to a single scheduled check-in.
model EmergencyContact {
  id        String   @id @default(uuid())
  userId    String
  name      String
  phone     String
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("emergency_contacts")
}

// A live "help now" trigger during a date, distinct from DateCheckIn's
// lazy missed-check-in alert: sent immediately to the selected
// EmergencyContact rows with the sender's current coordinates.
model SosAlert {
  id         String   @id @default(uuid())
  userId     String
  matchId    String?
  latitude   Float
  longitude  Float
  contactIds String[] @default([])
  createdAt  DateTime @default(now())

  @@index([userId])
  @@map("sos_alerts")
}

// A proactive, non-emergency location share sent to trusted contacts when a
// date starts - distinct from SosAlert's urgent "help now" trigger and
// DateCheckIn's lazy missed-check-in alert. Delivers the destination address
// and a live-location link immediately, the same SMS mechanism as SosAlert.
model DateLocationShare {
  id                 String   @id @default(uuid())
  userId             String
  matchId            String?
  destinationAddress String?
  latitude           Float
  longitude          Float
  contactIds         String[] @default([])
  createdAt          DateTime @default(now())

  @@index([userId])
  @@map("date_location_shares")
}

model PathCrossing {
  id         String   @id @default(uuid())
  userAId    String
  userBId    String
  latitude   Float
  longitude  Float
  distanceKm Float
  crossedAt  DateTime @default(now())

  @@index([userAId, crossedAt])
  @@index([userBId, crossedAt])
  @@map("path_crossings")
}

model Question {
  id        String   @id @default(uuid())
  text      String
  options   String[]
  createdAt DateTime @default(now())

  answers QuestionAnswer[]

  @@map("questions")
}

model QuestionAnswer {
  id                String   @id @default(uuid())
  userId            String
  questionId        String
  answer            String
  acceptableAnswers String[]
  importance        String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  question Question @relation(fields: [questionId], references: [id])

  @@unique([userId, questionId])
  @@index([userId])
  @@index([questionId])
  @@map("question_answers")
}

model DailyPick {
  id                 String   @id @default(uuid())
  userId             String
  candidateId        String
  windowStart        DateTime
  compatibilityScore Int?
  createdAt          DateTime @default(now())

  @@unique([userId, candidateId, windowStart])
  @@index([userId, windowStart])
  @@map("daily_picks")
}

model ProfileItemLike {
  id         String   @id @default(uuid())
  fromUserId String
  toUserId   String
  itemType   String
  comment    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([fromUserId, toUserId, itemType])
  @@index([toUserId])
  @@index([fromUserId])
  @@map("profile_item_likes")
}

model Application {
  id              String    @id @default(uuid())
  userId          String    @unique
  status          String    @default("PENDING")
  referralCount   Int       @default(0)
  // Links (Instagram, LinkedIn, etc.) the applicant submits for the
  // committee to cross-check identity/authenticity against - see
  // VettingService.apply.
  socialLinks     String[]  @default([])
  decidedByUserId String?
  decisionReason  String?
  createdAt       DateTime  @default(now())
  decidedAt       DateTime?

  referrals Referral[]

  @@index([status])
  @@map("applications")
}

model Referral {
  id             String   @id @default(uuid())
  applicationId  String
  referrerUserId String
  createdAt      DateTime @default(now())

  application Application @relation(fields: [applicationId], references: [id])

  @@unique([applicationId, referrerUserId])
  @@index([applicationId])
  @@map("referrals")
}

// "VIP Referral Access Codes": a selfie-verified member's single-use invite
// code that lets a referred contact bypass the standard Application
// waitlist/committee-approval queue entirely - see
// VipReferralService.redeemVipCode. Distinct from the reusable
// User.referralCode (which only adds a peer referral toward the normal
// REQUIRED_PEER_REFERRALS threshold, still gated on committee decide()).
model VipReferralCode {
  id               String    @id @default(uuid())
  code             String    @unique
  ownerId          String
  consumedAt       DateTime?
  consumedByUserId String?
  createdAt        DateTime  @default(now())

  @@index([ownerId])
  @@map("vip_referral_codes")
}

model CouplePairing {
  id          String    @id @default(uuid())
  requesterId String
  partnerId   String
  status      String    @default("PENDING")
  createdAt   DateTime  @default(now())
  respondedAt DateTime?

  @@unique([requesterId, partnerId])
  @@index([requesterId])
  @@index([partnerId])
  @@map("couple_pairings")
}

// A confirmed, active link between two users. A user may hold multiple
// concurrent PartnerLink rows to support polyamorous relationship
// structures rather than a single exclusive partner.
model PartnerLink {
  id                   String   @id @default(uuid())
  userAId              String
  userBId              String
  jointBrowsingEnabled Boolean  @default(false)
  createdAt            DateTime @default(now())

  @@unique([userAId, userBId])
  @@index([userAId])
  @@index([userBId])
  @@map("partner_links")
}

model PersonalityProfile {
  id              String   @id @default(uuid())
  userId          String   @unique
  dimensionScores Json
  completedAt     DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("personality_profiles")
}

model TopicQuizProfile {
  id          String   @id @default(uuid())
  userId      String   @unique
  responses   Json
  completedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("topic_quiz_profiles")
}

model CallSession {
  id                       String    @id @default(uuid())
  matchId                  String
  callerId                 String
  calleeId                 String
  type                     String
  status                   String    @default("RINGING")
  offerSdp                 String
  answerSdp                String?
  virtualBackgroundId      String?
  // "Video Date Mode" subtle appearance filter (skin smoothing, warm/cool
  // tone, brightening) - a separate, purely cosmetic overlay from
  // virtualBackgroundId's backdrop swap. See CallingService.setAppearanceFilter.
  appearanceFilterId       String?
  activeIcebreakerPromptId String?
  callerMuted              Boolean   @default(false)
  calleeMuted              Boolean   @default(false)
  callerVideoEnabled       Boolean   @default(true)
  calleeVideoEnabled       Boolean   @default(true)
  createdAt                DateTime  @default(now())
  endedAt                  DateTime?

  iceCandidates CallIceCandidate[]

  @@index([matchId])
  @@index([calleeId, status])
  @@map("call_sessions")
}

model CallIceCandidate {
  id            String   @id @default(uuid())
  callSessionId String
  senderId      String
  candidate     String
  createdAt     DateTime @default(now())

  callSession CallSession @relation(fields: [callSessionId], references: [id])

  @@index([callSessionId])
  @@map("call_ice_candidates")
}

// A flagged transcript snippet from a live call - the client runs its own
// on-device speech-to-text and submits short snippets for real-time
// moderation (see CallingService.checkTranscript); only flagged ones are
// persisted, since routine conversation isn't safety-relevant.
model CallModerationFlag {
  id                String   @id @default(uuid())
  callSessionId     String
  senderId          String
  transcriptSnippet String
  categories        String[] @default([])
  createdAt         DateTime @default(now())

  @@index([callSessionId])
  @@map("call_moderation_flags")
}

model Boost {
  id             String   @id @default(uuid())
  userId         String
  expiresAt      DateTime
  viewCount      Int      @default(0)
  tier           String   @default("STANDARD")
  viewMultiplier Int      @default(1)
  createdAt      DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@map("boosts")
}

// A public video broadcast a user hosts. The video transport itself isn't
// modeled here (no media/SFU server exists in this codebase) - this tracks
// the session lifecycle plus the real-time interactions (viewer count,
// likes, comments) that ride alongside it.
model LiveStream {
  id          String    @id @default(uuid())
  hostId      String
  title       String
  status      String    @default("LIVE")
  viewerCount Int       @default(0)
  likeCount   Int       @default(0)
  startedAt   DateTime  @default(now())
  endedAt     DateTime?

  comments LiveStreamComment[]

  @@index([hostId])
  @@index([status])
  @@map("live_streams")
}

model LiveStreamComment {
  id        String   @id @default(uuid())
  streamId  String
  userId    String
  text      String
  createdAt DateTime @default(now())

  stream LiveStream @relation(fields: [streamId], references: [id])

  @@index([streamId])
  @@map("live_stream_comments")
}

// A trace of a match dissolved because its first-message window expired
// with nobody messaging. Kept (unlike the Match/Swipe rows it replaces, which
// are hard-deleted so the pair becomes rediscoverable in the deck) so a
// premium user can explicitly reconnect instead of relying on organically
// re-swiping each other.
model DissolvedMatch {
  id          String   @id @default(uuid())
  userAId     String
  userBId     String
  dissolvedAt DateTime @default(now())

  @@index([userAId])
  @@index([userBId])
  @@map("dissolved_matches")
}

// A la carte "Unmatch Protection" (see User.unmatchProtectionEnabled and
// PowerUpsService): a read-only snapshot of a dissolved match's messages,
// taken at dissolve time instead of letting MessagingService.dissolveMatch
// delete them outright.
model ArchivedMessage {
  id               String   @id @default(uuid())
  dissolvedMatchId String
  senderId         String
  contentType      String
  content          String?
  mediaUrl         String?
  createdAt        DateTime

  @@index([dissolvedMatchId])
  @@map("archived_messages")
}

// A recorded profile view. Anonymous (premium-only) visits are simply never
// written here - see ProfileVisitsService.recordVisit - rather than being
// stored with a "hidden" flag, so there's truly no footprint to leak.
model ProfileVisit {
  id            String   @id @default(uuid())
  visitorId     String
  visitedUserId String
  createdAt     DateTime @default(now())

  @@index([visitorId])
  @@index([visitedUserId])
  @@map("profile_visits")
}

// An extra photo that stays private by default; the owner explicitly grants
// a specific match access to it (see VaultPhotoGrant) rather than it being
// visible on the profile or in chat. Optionally grouped into a named
// VaultAlbum (a "gallery") so a whole set of photos can be locked/unlocked
// for a match in one action instead of one grant per photo - see
// VaultAlbumGrant.
model VaultPhoto {
  id        String   @id @default(uuid())
  ownerId   String
  mediaUrl  String
  albumId   String?
  createdAt DateTime @default(now())

  grants VaultPhotoGrant[]
  album  VaultAlbum? @relation(fields: [albumId], references: [id])

  @@index([ownerId])
  @@index([albumId])
  @@map("vault_photos")
}

model VaultPhotoGrant {
  id           String    @id @default(uuid())
  vaultPhotoId String
  matchId      String
  grantedAt    DateTime  @default(now())
  // Optional key expiry - see VaultService.grantAccess/isGrantExpired. Null
  // means the grant lasts until explicitly revoked, same as before this
  // field existed.
  expiresAt    DateTime?

  vaultPhoto VaultPhoto @relation(fields: [vaultPhotoId], references: [id])

  @@unique([vaultPhotoId, matchId])
  @@index([vaultPhotoId])
  @@index([matchId])
  @@map("vault_photo_grants")
}

// A named grouping of VaultPhotos (a "gallery") that can be locked/unlocked
// for a match as a single unit via VaultAlbumGrant, instead of granting each
// photo in it individually.
model VaultAlbum {
  id        String   @id @default(uuid())
  ownerId   String
  name      String
  createdAt DateTime @default(now())

  photos VaultPhoto[]
  grants VaultAlbumGrant[]

  @@index([ownerId])
  @@map("vault_albums")
}

model VaultAlbumGrant {
  id           String   @id @default(uuid())
  vaultAlbumId String
  matchId      String
  grantedAt    DateTime @default(now())

  vaultAlbum VaultAlbum @relation(fields: [vaultAlbumId], references: [id])

  @@unique([vaultAlbumId, matchId])
  @@index([vaultAlbumId])
  @@index([matchId])
  @@map("vault_album_grants")
}

// A user's pick of a suggested venue category (see VENUE_CATEGORIES) for a
// specific match - one active pick per user per match, changeable at any
// time. When both sides of a match have picked the same category,
// DateSuggestionsService.suggestMeetupSpots surfaces it as a mutual pick.
model MeetupSpotPick {
  id         String   @id @default(uuid())
  matchId    String
  userId     String
  categoryId String
  createdAt  DateTime @default(now())

  @@unique([matchId, userId])
  @@index([matchId])
  @@map("meetup_spot_picks")
}

// App-sponsored offline singles events (mixers, meetups, activities).
// There's no admin panel anywhere in this codebase, so creation is gated by
// the existing `isCommitteeMember` flag (already used the same way to gate
// committee actions in the vetting module) rather than a new admin role.
model LocalEvent {
  id          String   @id @default(uuid())
  title       String
  description String?
  location    String
  latitude    Float?
  longitude   Float?
  category    String
  startsAt    DateTime
  createdById String
  createdAt   DateTime @default(now())
  // In-app-currency access pass price (see User.giftTokenBalance, the same
  // "coins" gifting/wallet already spend from - there's no real payment
  // provider anywhere in this codebase). 0 means a free, RSVP-only event.
  priceCoins  Int      @default(0)

  rsvps LocalEventRsvp[]

  @@index([startsAt])
  @@map("local_events")
}

model LocalEventRsvp {
  id          String    @id @default(uuid())
  eventId     String
  userId      String
  checkedInAt DateTime?
  createdAt   DateTime  @default(now())
  // Snapshot of what was actually charged at RSVP time, refunded verbatim
  // on cancellation - stays correct even if the event's priceCoins changes
  // later, same pattern GiftTransaction.tokenCost already uses.
  coinsSpent  Int       @default(0)

  event LocalEvent @relation(fields: [eventId], references: [id])

  @@unique([eventId, userId])
  @@index([eventId])
  @@index([userId])
  @@map("local_event_rsvps")
}

// A user's photo gallery, ordered by `position` (lowest = the lead photo
// shown in the discovery deck, mirrored onto User.profilePhotoUrl).
// `impressions`/`rightSwipes` accumulate while a photo is in the lead
// position (see DiscoveryService.recordSwipe) so the lead can automatically
// rotate to whichever photo is converting best.
model ProfilePhoto {
  id           String   @id @default(uuid())
  ownerId      String
  mediaUrl     String
  position     Int
  impressions  Int      @default(0)
  rightSwipes  Int      @default(0)
  qualityScore Int      @default(0)
  // Normalized (0-1) smart-crop focal point - see detectFaceFocalPoint in
  // profile-photos.service.ts - so clients can center-crop this photo
  // consistently across different aspect ratio containers.
  cropFocalX   Float    @default(0.5)
  cropFocalY   Float    @default(0.35)
  // User-written context or humor caption shown under this photo - see
  // ProfilePhotosService.setPhotoCaption. Null until the owner sets one.
  caption      String?
  createdAt    DateTime @default(now())

  @@index([ownerId])
  @@index([ownerId, position])
  @@map("profile_photos")
}

// An in-app notification feed entry (new match, new message, etc). No real
// WebSocket/FCM/APNs transport exists in this codebase - NotificationsService
// persists these for the REST feed the client polls, and would hand off to a
// real push provider here once one is wired up (see DeviceToken).
model Notification {
  id        String    @id @default(uuid())
  userId    String
  type      String
  title     String
  body      String
  data      Json?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([userId, readAt])
  @@map("notifications")
}

// A registered FCM/APNs/web-push device token for a user, standing in for
// the client-side push registration step - see the note on Notification.
model DeviceToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  platform  String
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("device_tokens")
}
